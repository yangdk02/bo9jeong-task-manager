{
  "name": "bo9jeong-task-manager",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/init-local-data.mjs --seed",
    "dev": "next dev",
    "build": "node scripts/setup-supabase.mjs --if-configured && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "init:data": "node scripts/init-local-data.mjs",
    "init:data:seed": "node scripts/init-local-data.mjs --seed",
    "setup:supabase": "node --env-file-if-exists=.env.local scripts/setup-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "csv-parse": "^7.0.3",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
